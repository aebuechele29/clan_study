black_head == 1, year >= 2000, year <= 2010) %>%
ggplot(aes(x = factor(year), y = wealth, size = numfu, weight = fam_weight)) +
geom_jitter(alpha = 0.3, color = ORANGE, width = 0.2) +
scale_y_continuous(labels = scales::dollar_format(scale = 1e-3, suffix = "k"),
trans = "log10") +
scale_size_continuous(name = "Household size (numfu)", range = c(1, 8)) +
labs(x = NULL, y = "Wealth per person (log scale)") +
theme_minimal(base_size = base_size, base_family = base_family) +
theme(legend.position = "bottom")
r_hh_wealth %>%
mutate(wealth = wealth / numfu) %>%
filter(is.finite(wealth), is.finite(fam_weight), fam_weight > 0,
!is.na(black_head), black_head %in% c(0, 1),
year >= 2000, year <= 2010) %>%
mutate(race = ifelse(black_head == 1, "Black", "Non-Black")) %>%
group_by(year, race, numfu) %>%
summarise(
weighted   = sum(wealth * fam_weight) / sum(fam_weight),
unweighted = mean(wealth),
.groups = "drop"
) %>%
tidyr::pivot_longer(c(weighted, unweighted),
names_to = "type", values_to = "mean_wealth") %>%
ggplot(aes(x = numfu, y = mean_wealth, color = race, linetype = type)) +
geom_line(linewidth = 1.2) +
facet_wrap(~ year, nrow = 2) +
scale_color_manual(values = c("Black" = ORANGE, "Non-Black" = BLUE), name = NULL) +
scale_linetype_manual(values = c("weighted" = "solid", "unweighted" = "dotted"), name = NULL) +
scale_y_continuous(labels = scales::dollar_format(scale = 1e-3, suffix = "k")) +
labs(x = "Household size (numfu)", y = "Mean wealth per person") +
theme_minimal(base_size = base_size, base_family = base_family) +
theme(legend.position = "bottom")
# ── Figure 3_alt — Mean Wealth Ratios: Weighted vs Unweighted, with Outlier Trim ──
# ── Panel B helper: compute trimmed ratios by year ────────────────────────────
# Trim top 2.5% separately within each race group, then compute weighted mean ratio
compute_trimmed_ratios <- function(df, black_var, weight_var, wealth_var, year_var = "year") {
df %>%
filter(is.finite(.data[[wealth_var]]),
is.finite(.data[[weight_var]]),
.data[[weight_var]] > 0) %>%
group_by(.data[[year_var]], .data[[black_var]]) %>%
mutate(
cutoff = wtd_quantile(.data[[wealth_var]], .data[[weight_var]], probs = 0.975),
keep   = .data[[wealth_var]] <= cutoff
) %>%
ungroup() %>%
filter(keep) %>%
group_by(.data[[year_var]], .data[[black_var]]) %>%
summarise(
wtd_mean  = wtd_mean(.data[[wealth_var]], .data[[weight_var]]),
unwtd_mean = mean(.data[[wealth_var]]),
.groups = "drop"
)
}
make_trimmed_ratio_tbl <- function(df_hh, df_cl,
black_hh, weight_hh, wealth_hh,
black_cl, weight_cl, wealth_cl) {
hh_trim <- compute_trimmed_ratios(df_hh, black_hh, weight_hh, wealth_hh) %>%
pivot_wider(names_from = black_hh,
values_from = c(wtd_mean, unwtd_mean),
names_prefix = "") %>%
# columns: year, wtd_mean_0, wtd_mean_1, unwtd_mean_0, unwtd_mean_1
rename_with(~ gsub("_0$", "_nonblack", gsub("_1$", "_black", .x))) %>%
mutate(
r_hh_w_trim_mean_ratio  = wtd_mean_black   / wtd_mean_nonblack,
r_hh_u_trim_mean_ratio  = unwtd_mean_black / unwtd_mean_nonblack
) %>%
select(year, r_hh_w_trim_mean_ratio, r_hh_u_trim_mean_ratio)
cl_trim <- compute_trimmed_ratios(df_cl, black_cl, weight_cl, wealth_cl) %>%
pivot_wider(names_from = black_cl,
values_from = c(wtd_mean, unwtd_mean),
names_prefix = "") %>%
rename_with(~ gsub("_0$", "_nonblack", gsub("_1$", "_black", .x))) %>%
mutate(
r_cl_w_trim_mean_ratio  = wtd_mean_black   / wtd_mean_nonblack,
r_cl_u_trim_mean_ratio  = unwtd_mean_black / unwtd_mean_nonblack
) %>%
select(year, r_cl_w_trim_mean_ratio, r_cl_u_trim_mean_ratio)
hh_trim %>% left_join(cl_trim, by = "year")
}
trimmed_ratios <- make_trimmed_ratio_tbl(
df_hh   = r_hh_wealth    %>% mutate(wealth = wealth / numfu),
df_cl   = r_clans_wealth %>% mutate(wealth = wealth / numclan),
black_hh  = "black_head",  weight_hh = "fam_weight",  wealth_hh = "wealth",
black_cl  = "black_clan",  weight_cl = "clan_weight",  wealth_cl = "wealth"
)
# ── Panel A: standard mean ratio — weighted vs unweighted, 4 lines ────────────
# Uses wealth_ratios (already loaded) which has r_hh_w_mean_ratio, r_hh_u_mean_ratio,
# r_cl_w_mean_ratio, r_cl_u_mean_ratio
make_4line_ratio_plot <- function(dat,
hh_w_col, hh_u_col,
cl_w_col, cl_u_col,
ylab     = "Black / Non-Black",
y_limits = NULL) {
plot_dat <- dat %>%
filter(year != "ALL") %>%
mutate(year = as.numeric(year)) %>%
select(year,
`HH weighted`     = all_of(hh_w_col),
`HH unweighted`   = all_of(hh_u_col),
`Clan weighted`   = all_of(cl_w_col),
`Clan unweighted` = all_of(cl_u_col)) %>%
pivot_longer(-year, names_to = "series", values_to = "value") %>%
mutate(
unit   = if_else(str_detect(series, "^HH"), "Household", "Clan"),
wt     = if_else(str_detect(series, "weighted$") &
!str_detect(series, "un"), "Weighted", "Unweighted")
)
color_map <- c("Household" = ORANGE, "Clan" = BLUE)
ltype_map <- c("Weighted" = "solid", "Unweighted" = "dashed")
p <- ggplot(plot_dat, aes(x = year, y = value,
color = unit, linetype = wt,
group = series)) +
geom_line(linewidth = 1.1) +
geom_hline(yintercept = 1, linetype = "dotted", color = "grey40") +
scale_color_manual(values = color_map, name = NULL) +
scale_linetype_manual(values = ltype_map, name = NULL) +
scale_x_continuous(breaks = pretty(dat$year[dat$year != "ALL" &
is.finite(as.numeric(dat$year))], n = 6)) +
labs(x = NULL, y = ylab) +
theme(
legend.position  = "bottom",
legend.key.width = unit(1.8, "cm"),
panel.grid.minor = element_blank()
) +
guides(
color    = guide_legend(order = 1, override.aes = list(linewidth = 1.1)),
linetype = guide_legend(order = 2, override.aes = list(linewidth = 1.1))
)
if (!is.null(y_limits)) p <- p + coord_cartesian(ylim = y_limits)
p
}
# ── Panel B: trimmed mean ratio — weighted vs unweighted, 4 lines ─────────────
# Same plotting function, different data
# Shared y limits across both panels
fig3alt_all_vals <- c(
wealth_ratios$r_hh_w_mean_ratio, wealth_ratios$r_hh_u_mean_ratio,
wealth_ratios$r_cl_w_mean_ratio, wealth_ratios$r_cl_u_mean_ratio,
trimmed_ratios$r_hh_w_trim_mean_ratio, trimmed_ratios$r_hh_u_trim_mean_ratio,
trimmed_ratios$r_cl_w_trim_mean_ratio, trimmed_ratios$r_cl_u_trim_mean_ratio
)
fig3alt_all_vals <- fig3alt_all_vals[is.finite(fig3alt_all_vals)]
shared_y_fig3alt <- c(
floor(min(fig3alt_all_vals)   * 20) / 20,
ceiling(max(fig3alt_all_vals) * 20) / 20 + 0.05
)
fig3alt_A <- make_4line_ratio_plot(
dat      = wealth_ratios,
hh_w_col = "r_hh_w_mean_ratio",
hh_u_col = "r_hh_u_mean_ratio",
cl_w_col = "r_cl_w_mean_ratio",
cl_u_col = "r_cl_u_mean_ratio",
ylab     = "Black / Non-Black",
y_limits = shared_y_fig3alt
)
fig3alt_B <- make_4line_ratio_plot(
dat      = trimmed_ratios,
hh_w_col = "r_hh_w_trim_mean_ratio",
hh_u_col = "r_hh_u_trim_mean_ratio",
cl_w_col = "r_cl_w_trim_mean_ratio",
cl_u_col = "r_cl_u_trim_mean_ratio",
ylab     = "Black / Non-Black",
y_limits = shared_y_fig3alt
)
# ── Assemble figure ───────────────────────────────────────────────────────────
fig3alt <- arrangeGrob(
textGrob(
"Figure 3 (alt). Black / Non-Black Mean Wealth Ratios: Weighted vs. Unweighted",
x = unit(0, "npc"), just = "left",
gp = gpar(fontfamily = base_family, fontface = "bold", fontsize = title_size)
),
arrangeGrob(
arrangeGrob(
textGrob("Panel A: Mean wealth ratio (full sample)",
x = unit(0, "npc"), just = "left",
gp = gpar(fontfamily = base_family, fontsize = sub_size)),
fig3alt_A, ncol = 1, heights = c(1, 12)
),
arrangeGrob(
textGrob("Panel B: Mean wealth ratio (top 2.5% trimmed by race group)",
x = unit(0, "npc"), just = "left",
gp = gpar(fontfamily = base_family, fontsize = sub_size)),
fig3alt_B, ncol = 1, heights = c(1, 12)
),
ncol = 2
),
ncol = 1, heights = unit(c(0.5, 10.0), "inches")
)
if (SAVE_FILES) {
ggsave(here("9_figures", "output", "figure3_alt.pdf"), fig3alt, width = 14, height = 11)
message("Saved: figure3_alt.pdf")
}
