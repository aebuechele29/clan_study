library(dplyr)
library(tidyr)
library(ggplot2)
# Helper: reshape wide -> long for all C1* columns, split HH/Clan
prep_c1_long <- function(df) {
df %>%
filter(year != "ALL") %>%
mutate(year = as.numeric(year)) %>%
select(year, starts_with("C1_")) %>%
pivot_longer(
cols = -year,
names_to = "metric_group",
values_to = "value"
) %>%
# metric = C1_all / C1_ex_top_10 / C1_ex_bottom_10
# group  = HH / Clan
tidyr::separate(metric_group, into = c("metric", "group"),
sep = "_(HH|Clan)$", remove = FALSE, extra = "drop", fill = "right") %>%
mutate(
group = ifelse(endsWith(metric_group, "_Clan"), "Clan", "HH"),
metric = sub("_(HH|Clan)$", "", metric_group),
group = factor(group, levels = c("HH", "Clan")),
metric = factor(metric, levels = c("C1_all", "C1_ex_top_10", "C1_ex_bottom_10"))
) %>%
select(year, metric, group, value)
}
# Plot function: 6 lines total, Clan dotted
plot_c1 <- function(df, title) {
dd <- prep_c1_long(df)
ggplot(dd, aes(x = year, y = value, color = metric, linetype = group)) +
geom_line(size = 0.9) +
scale_linetype_manual(values = c(HH = "solid", Clan = "dotted")) +
labs(
title = title,
x = "Year",
y = "Value",
color = "C1 variant",
linetype = "Group"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
}
# ---- Make the three plots ----
p_inc            <- plot_c1(inc,            "Income — C1 (All / Ex Top 10% / Ex Bottom 10%)")
p_wealth_nohouse <- plot_c1(wealth_nohouse, "Wealth (No Housing) — C1 (All / Ex Top 10% / Ex Bottom 10%)")
p_wealth         <- plot_c1(wealth,         "Wealth — C1 (All / Ex Top 10% / Ex Bottom 10%)")
# Print (or save with ggsave)
print(p_inc)
print(p_wealth_nohouse)
print(p_wealth)
