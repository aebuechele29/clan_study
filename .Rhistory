print(p_inc)
library(dplyr)
library(tidyr)
library(ggplot2)
# Helper: reshape wide -> long for a given component ("C1", "C2", "C3")
prep_comp_long <- function(df, comp = c("C1", "C2", "C3")) {
comp <- match.arg(comp)
prefix <- paste0(comp, "_")
df %>%
filter(year != "ALL") %>%
mutate(year = suppressWarnings(as.numeric(year))) %>%
select(year, starts_with(prefix)) %>%
pivot_longer(cols = -year, names_to = "metric_group", values_to = "value") %>%
mutate(
group  = ifelse(grepl("_clan$", metric_group), "clan", "hh"),
metric = sub("_(hh|clan)$", "", metric_group),
metric = factor(
metric,
levels = c(paste0(prefix, "all"),
paste0(prefix, "ex_top_10"),
paste0(prefix, "ex_bottom_10"))
),
group = factor(group, levels = c("hh", "clan"))
) %>%
select(year, metric, group, value)
}
# Plot function: 6 lines total (3 hh solid, 3 clan dotted)
plot_comp <- function(df, comp = c("C1", "C2", "C3"), title = NULL) {
comp <- match.arg(comp)
dd <- prep_comp_long(df, comp)
if (is.null(title)) {
title <- paste0(comp, " — All / Ex Top 10% / Ex Bottom 10%")
}
ggplot(dd, aes(x = year, y = value, color = metric, linetype = group)) +
geom_line(size = 0.9) +
scale_linetype_manual(values = c(hh = "solid", clan = "dotted")) +
labs(
title = title,
x = "Year",
y = "Value",
color = paste0(comp, " variant"),
linetype = "Group"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
}
