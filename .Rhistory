)
find_col <- function(df, candidates) {
hit <- intersect(candidates, names(df))
if (length(hit) == 0) NA_character_ else hit[1]
}
hh_size_col      <- find_col(inc_family_demo_full, full_col_candidates$hh_size)
clan_nhh_col     <- find_col(inc_family_demo_full, full_col_candidates$clan_nhh)
clan_npeople_col <- find_col(inc_family_demo_full, full_col_candidates$clan_npeople)
if (any(is.na(c(hh_size_col, clan_nhh_col, clan_npeople_col)))) {
stop(
"Could not find the full-sample size columns in inc_family_demo_full.csv.\n\n",
"Columns actually present in that file:\n  ",
paste(names(inc_family_demo_full), collapse = ", "), "\n\n",
"Please tell me either:\n",
"  (a) the correct column name(s) for household size / # households per clan / ",
"# people per clan in inc_family_demo_full.csv, or\n",
"  (b) the path to the unfiltered (non-robust) household and clan RDS files, ",
"so I can compute these directly, the same way the robust versions are computed above."
)
}
View(r_hh)
View(inc_family_demo_full)
# ══════════════════════════════════════════════════════════════════════════
# STANDALONE SCRIPT — Household and Kin Group Size Over Time
# Robust (kin-linked) sample vs. Full (unrestricted, non-robust) PSID sample
# ══════════════════════════════════════════════════════════════════════════
#
# Three size measures, each its own panel, Robust (solid) vs. Full Sample
# (dotted), following the same visual conventions as Figure 4:
#
#   1. Household size              -- numfu            (# people in a hh)
#   2. Kin group size (households) -- numclan           (# hh per clan)
#   3. Kin group size (people)     -- num_clan_people   (# people per clan)
#
# Uses the income sample (r_hh / r_clans), the same choice Figure 4 made for
# its robust-vs-full age comparison. Swap in r_hh_wealth / r_clans_wealth if
# you'd rather see the wealth sample.
#
# ── DATA SOURCES (confirmed) ────────────────────────────────────────────────
#   * Robust household size  -- numfu, fam_weight  from robust_households.rds
#   * Robust kin group size  -- numclan, num_clan_people, clan_weight
#                                from robust_clans.rds
#   * Full-sample household size -- numfu, fam_weight from the UNFILTERED
#     3_households/output/households.rds
#   * Full-sample kin group size -- numclan, num_clan_people are already
#     precomputed (unweighted) means by year in
#     5_summary/output/inc_family_demo_full.csv
# ══════════════════════════════════════════════════════════════════════════
library(here)
library(dplyr)
library(tidyr)
library(readr)
library(ggplot2)
source(here::here("functions", "all_functions.R"))
if (!exists("SAVE_FILES")) SAVE_FILES <- TRUE
dir.create(here("9_figures", "output"), recursive = TRUE, showWarnings = FALSE)
# Global styles (mirrors 9_figures conventions)
base_family <- "serif"
base_size   <- 22
title_size  <- 26
sub_size    <- 24
NAVY  <- "#185FA5"
CORAL <- "#D85A30"
theme_set(theme_minimal(base_size = base_size, base_family = base_family))
fmt1 <- function(x) format(round(x, 1), nsmall = 1)
# ── Load data ────────────────────────────────────────────────────────────
r_hh      <- readRDS(here("3_households", "output", "robust_households.rds"))
r_clans   <- readRDS(here("4_clans",      "output", "robust_clans.rds"))
full_hh   <- readRDS(here("3_households", "output", "households.rds"))
inc_family_demo_full <- read_csv(here("5_summary", "output", "inc_family_demo_full.csv"),
show_col_types = FALSE)
# ── ROBUST sample: weighted mean size by year ───────────────────────────────
robust_hh_size <- r_hh %>%
filter(is.finite(numfu), is.finite(fam_weight), fam_weight > 0) %>%
group_by(year) %>%
summarise(value = wtd_mean(numfu, fam_weight), .groups = "drop") %>%
mutate(measure = "Household size (# people)")
robust_clan_nhh <- r_clans %>%
filter(is.finite(numclan), is.finite(clan_weight), clan_weight > 0) %>%
group_by(year) %>%
summarise(value = wtd_mean(numclan, clan_weight), .groups = "drop") %>%
mutate(measure = "Kin group size (# households)")
robust_clan_npeople <- r_clans %>%
filter(is.finite(num_clan_people), is.finite(clan_weight), clan_weight > 0) %>%
group_by(year) %>%
summarise(value = wtd_mean(num_clan_people, clan_weight), .groups = "drop") %>%
mutate(measure = "Kin group size (# people)")
robust_size <- bind_rows(robust_hh_size, robust_clan_nhh, robust_clan_npeople) %>%
mutate(sample = "Robust")
# ── FULL (non-robust) sample ────────────────────────────────────────────────
# Household size: computed from the unfiltered households.rds, weighted the
# same way as the robust version above.
full_hh_size <- full_hh %>%
filter(is.finite(numfu), is.finite(fam_weight), fam_weight > 0) %>%
group_by(year) %>%
summarise(value = wtd_mean(numfu, fam_weight), .groups = "drop") %>%
mutate(measure = "Household size (# people)")
# Kin group size: numclan and num_clan_people are already precomputed means
# by year in inc_family_demo_full.csv.
full_clan_nhh <- inc_family_demo_full %>%
transmute(year, value = numclan, measure = "Kin group size (# households)")
full_clan_npeople <- inc_family_demo_full %>%
transmute(year, value = num_clan_people, measure = "Kin group size (# people)")
full_size <- bind_rows(full_hh_size, full_clan_nhh, full_clan_npeople) %>%
mutate(sample = "Full Sample")
# ── Combine ─────────────────────────────────────────────────────────────────
size_plot_dat <- bind_rows(robust_size, full_size) %>%
mutate(
measure = factor(measure, levels = c("Household size (# people)",
"Kin group size (# households)",
"Kin group size (# people)")),
sample  = factor(sample, levels = c("Robust", "Full Sample"))
)
sample_colors <- c("Robust" = NAVY, "Full Sample" = CORAL)
size_br <- pretty(size_plot_dat$year, n = 6)
# ── Plot: one panel per measure, robust (solid) vs. full (dotted) ──────────
size_plot <- ggplot(size_plot_dat,
aes(x = year, y = value, color = sample, linetype = sample,
group = sample)) +
geom_line(linewidth = 1.5) +
facet_wrap(~ measure, nrow = 1, scales = "free_y") +
scale_color_manual(values = sample_colors, name = NULL) +
scale_linetype_manual(values = c("Robust" = "solid", "Full Sample" = "dotted"),
name = NULL) +
scale_x_continuous(breaks = size_br, expand = expansion(mult = c(0.03, 0.03))) +
labs(x = NULL, y = "Value",
title = "Household and Kin Group Size Over Time") +
theme(
legend.position  = "bottom",
legend.text      = element_text(size = base_size * 0.6),
strip.text       = element_text(family = base_family, face = "bold", size = sub_size * 0.6),
axis.text.x      = element_text(angle = 45, hjust = 1, size = base_size * 0.55),
plot.title       = element_text(family = base_family, face = "bold",
size = title_size, hjust = 0)
) +
guides(color = guide_legend(override.aes = list(linewidth = 2.2)))
# ── Scalars for note text ────────────────────────────────────────────────────
size_first_yr <- min(size_plot_dat$year, na.rm = TRUE)
size_last_yr  <- max(size_plot_dat$year, na.rm = TRUE)
get_val  <- function(df, meas, samp, yr) {
df$value[df$measure == meas & df$sample == samp & df$year == yr]
}
pct_chg <- function(first, last) 100 * (last - first) / first
measures <- c("Household size (# people)",
"Kin group size (# households)",
"Kin group size (# people)")
size_note_lines <- vapply(measures, function(m) {
r_first <- get_val(size_plot_dat, m, "Robust", size_first_yr)
r_last  <- get_val(size_plot_dat, m, "Robust", size_last_yr)
f_first <- get_val(size_plot_dat, m, "Full Sample", size_first_yr)
f_last  <- get_val(size_plot_dat, m, "Full Sample", size_last_yr)
sprintf(
"%s changed by %s%% for the robust sample (%s in %d to %s in %d) and by %s%% for the full sample (%s to %s).",
m,
fmt1(pct_chg(r_first, r_last)), fmt1(r_first), size_first_yr, fmt1(r_last), size_last_yr,
fmt1(pct_chg(f_first, f_last)), fmt1(f_first), fmt1(f_last)
)
}, character(1))
size_note <- paste0(
sprintf("Note: This figure plots average household and kin group size over time (%d\u2013%d), ",
size_first_yr, size_last_yr),
"comparing the robust (kin-linked) sample used elsewhere in this paper against the full, ",
"non-robust PSID sample, using weighted data from the income sample. ",
paste(size_note_lines, collapse = " ")
)
message(size_note)
if (SAVE_FILES) {
ggsave(here("9_figures", "output", "figure_size_over_time.pdf"), size_plot,
width = 16, height = 7)
message("Saved: figure_size_over_time.pdf")
}
# ══════════════════════════════════════════════════════════════════════════
# STANDALONE SCRIPT — Household and Kin Group Size Over Time
# Robust (kin-linked) vs. Full (unrestricted) sample, each shown both
# weighted (fam_weight / clan_weight) and unweighted.
# ══════════════════════════════════════════════════════════════════════════
#
# Three size measures, each its own panel. Within a panel: color = Robust vs.
# Full Sample, linetype = Weighted vs. Unweighted (4 lines per panel).
#
#   1. Household size              -- numfu            (# people in a hh)
#   2. Kin group size (households) -- numclan           (# hh per clan)
#   3. Kin group size (people)     -- num_clan_people   (# people per clan)
#
# All four stats (robust/full x weighted/unweighted) are computed directly
# in this script from the raw RDS files — nothing else is read or written
# except the final figure.
#
# Uses the income sample (households.rds / robust_households.rds and
# clans.rds / robust_clans.rds). Swap in the *_wealth.rds files if you'd
# rather see the wealth sample.
# ══════════════════════════════════════════════════════════════════════════
library(here)
library(dplyr)
library(tidyr)
library(ggplot2)
source(here::here("functions", "all_functions.R"))  # for wtd_mean()
if (!exists("SAVE_FILES")) SAVE_FILES <- TRUE
dir.create(here("9_figures", "output"), recursive = TRUE, showWarnings = FALSE)
# Global styles (mirrors 9_figures conventions)
base_family <- "serif"
base_size   <- 22
title_size  <- 26
sub_size    <- 24
NAVY  <- "#185FA5"
CORAL <- "#D85A30"
theme_set(theme_minimal(base_size = base_size, base_family = base_family))
# Weighted mean that filters non-finite/non-positive weights per-variable,
# then defers to wtd_mean() from functions/all_functions.R.
wtd_mean_safe <- function(x, w) {
ok <- is.finite(x) & is.finite(w) & w > 0
if (!any(ok)) return(NA_real_)
wtd_mean(x[ok], w[ok])
}
# ── Load data ────────────────────────────────────────────────────────────
r_hh    <- readRDS(here("3_households", "output", "robust_households.rds"))
r_clans <- readRDS(here("4_clans",      "output", "robust_clans.rds"))
hh      <- readRDS(here("3_households", "output", "households.rds"))
clans   <- readRDS(here("4_clans",      "output", "clans.rds"))
# ── Helper: weighted + unweighted mean of value_var by year ────────────────
compute_size_stats <- function(df, value_var, weight_var, measure_label, sample_label) {
df %>%
group_by(year) %>%
summarise(
Unweighted = mean(.data[[value_var]], na.rm = TRUE),
Weighted   = wtd_mean_safe(.data[[value_var]], .data[[weight_var]]),
.groups = "drop"
) %>%
pivot_longer(c(Unweighted, Weighted), names_to = "weighting", values_to = "value") %>%
mutate(measure = measure_label, sample = sample_label)
}
size_plot_dat <- bind_rows(
compute_size_stats(r_hh,    "numfu",           "fam_weight",  "Household size (# people)",       "Robust"),
compute_size_stats(hh,      "numfu",           "fam_weight",  "Household size (# people)",       "Full Sample"),
compute_size_stats(r_clans, "numclan",         "clan_weight", "Kin group size (# households)",   "Robust"),
compute_size_stats(clans,   "numclan",         "clan_weight", "Kin group size (# households)",   "Full Sample"),
compute_size_stats(r_clans, "num_clan_people", "clan_weight", "Kin group size (# people)",        "Robust"),
compute_size_stats(clans,   "num_clan_people", "clan_weight", "Kin group size (# people)",        "Full Sample")
) %>%
mutate(
measure   = factor(measure, levels = c("Household size (# people)",
"Kin group size (# households)",
"Kin group size (# people)")),
sample    = factor(sample, levels = c("Robust", "Full Sample")),
weighting = factor(weighting, levels = c("Weighted", "Unweighted"))
)
sample_colors <- c("Robust" = NAVY, "Full Sample" = CORAL)
size_br <- pretty(size_plot_dat$year, n = 6)
# ── Plot: one panel per measure; color = sample, linetype = weighting ──────
size_plot <- ggplot(size_plot_dat,
aes(x = year, y = value, color = sample, linetype = weighting,
group = interaction(sample, weighting))) +
geom_line(linewidth = 1.3) +
facet_wrap(~ measure, nrow = 1, scales = "free_y") +
scale_color_manual(values = sample_colors, name = NULL) +
scale_linetype_manual(values = c("Weighted" = "solid", "Unweighted" = "dotted"),
name = NULL) +
scale_x_continuous(breaks = size_br, expand = expansion(mult = c(0.03, 0.03))) +
labs(x = NULL, y = "Value",
title = "Household and Kin Group Size Over Time") +
theme(
legend.position  = "bottom",
legend.text      = element_text(size = base_size * 0.6),
strip.text       = element_text(family = base_family, face = "bold", size = sub_size * 0.6),
axis.text.x      = element_text(angle = 45, hjust = 1, size = base_size * 0.55),
plot.title       = element_text(family = base_family, face = "bold",
size = title_size, hjust = 0)
) +
guides(color = guide_legend(override.aes = list(linewidth = 2.2)),
linetype = guide_legend(override.aes = list(linewidth = 1.2)))
if (SAVE_FILES) {
ggsave(here("9_figures", "output", "figure_size_over_time.pdf"), size_plot,
width = 16, height = 7)
message("Saved: figure_size_over_time.pdf")
}
