# PLOT AND COMPARE GINIS FOR ROBUST VERSUS NOT ROBUST SAMPLE
# Not robust sample (clans including single-HH clans)
cols_single <- pick_cols(
single_hh_clans,
hh_vars = c("hh_w_inc", "hh_w_wealth"),
cl_vars = c("cl_w_inc", "cl_w_wealth")
)
# PLOT AND COMPARE GINIS FOR ROBUST VERSUS NOT ROBUST SAMPLE
# Not robust sample (includes single-HH clans): use non-robust cols
single_hh_clans <- inc_by_year %>%
select(year, hh_w_inc, cl_w_inc) %>%
full_join(
wealth_by_year %>% select(year, hh_w_wealth, cl_w_wealth),
by = "year"
)
# Robust sample (multiple-HH clans only): use robust cols
multiple_hh_clans <- inc_by_year %>%
select(year, r_hh_w_inc, r_cl_w_inc) %>%
full_join(
wealth_by_year %>% select(year, r_hh_w_wealth, r_cl_w_wealth),
by = "year"
)
# Not robust (single-HH clans)
cols_single <- pick_cols(
single_hh_clans,
hh_vars = c("hh_w_wealth", "hh_w_inc"),
cl_vars = c("cl_w_wealth", "cl_w_inc")
)
df_single <- prep_plot_df(
single_hh_clans,
hh_col   = cols_single$hh,
cl_col   = cols_single$cl,
title_lab= "Sample: Single-household clans"
)
# Robust (multiple-HH clans)
cols_multiple <- pick_cols(
multiple_hh_clans,
hh_vars = c("r_hh_w_wealth", "r_hh_w_inc"),
cl_vars = c("r_cl_w_wealth", "r_cl_w_inc")
)
df_multiple <- prep_plot_df(
multiple_hh_clans,
hh_col   = cols_multiple$hh,
cl_col   = cols_multiple$cl,
title_lab= "Sample: Multiple-household clans"
)
# ---- Combine and plot ----
plot_df <- bind_rows(df_single, df_multiple)
ylims <- range(plot_df$Gini, na.rm = TRUE)
pad   <- diff(ylims) * 0.03; if (!is.finite(pad)) pad <- 0
ylims <- c(ylims[1] - pad, ylims[2] + pad)
p <- ggplot(
plot_df,
aes(x = year, y = Gini,
color = Unit,                   # HH vs Clan
linetype = PanelTitle,          # Single-HH vs Multiple-HH sample
group = interaction(Unit, PanelTitle))
) +
geom_line(linewidth = 1) +
geom_point(size = 1.8) +
scale_x_continuous(breaks = scales::pretty_breaks()) +
scale_y_continuous(limits = ylims) +
labs(
title    = "Ginis by Sample — Households vs Clans (Robust vs Not Robust)",
subtitle = "Linetype = Sample definition; Color = Unit",
x = "Year", y = "Gini", color = NULL, linetype = NULL
) +
theme_minimal(base_size = 13) +
theme(legend.position = "top",
plot.title = element_text(face = "bold", hjust = 0.5))
