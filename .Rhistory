table_income <- tibble(
Unit = c("Households", "Clans"),
N = c(
summary %>% filter(Table == "Income", Unit == "Household") %>% pull(N),
summary %>% filter(Table == "Income", Unit == "Clan") %>% pull(N)
),
`Black % Wtd.` = c(
summary %>% filter(Table == "Income", Unit == "Household") %>% pull(black_pct_w),
