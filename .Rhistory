inc_race_yr,
r_hh_w_inc_black, r_cl_w_inc_black,
r_hh_w_inc_nonblack, r_cl_w_inc_nonblack,
y_limits    = shared_y_race,
diff_limits = shared_y_race_diff,
ylab = "Gini Coefficient"
)
race6_w <- make_race_sensitivity_plot(
