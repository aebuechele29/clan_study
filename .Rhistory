# HYPOTHESIS 3
# Change in time, effort, and gender-typed tasks
## 1) ΔTime (OLS)
h3_dtime_1 <- lm(
diff_assign_time ~ cognitive_treatment + gender_treatment,
data = sim_data
)
h3_dtime_2 <- lm(
diff_assign_time ~ cognitive_treatment + gender_treatment + gender,
data = sim_data
)
## 2) ΔEffort (OLS or change to clm if ordinal)
h3_deff_1 <- lm(
diff_assign_effort ~ cognitive_treatment + gender_treatment,
data = sim_data
)
h3_deff_2 <- lm(
diff_assign_effort ~ cognitive_treatment + gender_treatment + gender,
data = sim_data
)
## 3) ΔGender-typed tasks (ordered logit)
sim_data <- sim_data %>%
mutate(
diff_assign_f_typ = abs(as.numeric(diff_assign_f_typ)),
diff_assign_f_typ = ordered(diff_assign_f_typ)
)
h3_ftyp_1 <- clm(
diff_assign_f_typ ~ cognitive_treatment + gender_treatment,
data = sim_data,
link = "logit"
)
h3_ftyp_2 <- clm(
diff_assign_f_typ ~ cognitive_treatment + gender_treatment + gender,
data = sim_data,
link = "logit"
)
## Put the 6 H3 models in one table
h3_models <- list(
"ΔTime: Treat only"   = h3_dtime_1,
"ΔTime: + Gender"     = h3_dtime_2,
"ΔEffort: Treat only" = h3_deff_1,
"ΔEffort: + Gender"   = h3_deff_2,
"ΔType: Treat only"   = h3_ftyp_1,
"ΔType: + Gender"     = h3_ftyp_2
)
modelsummary(
h3_models,
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE"
)
# Export to Word
modelsummary(
h3_models,
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE|AIC|BIC",
output    = "/Users/amanda/Desktop/commensuration/3_analysis/output/h3_models.docx"
)
