paste(control_vars, collapse = " + "))
),
data = sim_data,
link = "logit"
)
modelsummary(
list("ΔType: Treat only" = h1_ftyp_1,
"ΔType: + Gender"   = h1_ftyp_2,
"ΔType: + Controls" = h1_ftyp_3),
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE"
)
# Export
modelsummary(
list("ΔType: Treat only" = h1_ftyp_1,
"ΔType: + Gender"   = h1_ftyp_2,
