# Function to plot data with custom y-limits
plot <- function(df, comp = c("C1", "C2", "C3"), title = NULL, ylim = NULL) {
comp <- match.arg(comp)
dd <- prep_plot(df, comp)
if (is.null(title)) {
title <- paste0(comp, " — All / Ex Top 10% / Ex Bottom 10%")
}
p <- ggplot(dd, aes(x = year, y = value, color = metric, linetype = group)) +
geom_line(size = 0.9) +
scale_linetype_manual(values = c(hh = "solid", clan = "dotted")) +
labs(
title = title,
x = "Year",
y = "Value",
color = paste0(comp, " variant"),
linetype = "Group"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
# apply consistent y-axis scale if provided
if (!is.null(ylim)) p <- p + coord_cartesian(ylim = ylim)
return(p)
}
