# INCOME -----------------------------------------------------------------------------
# Compute global y-limits for C1–C3 across the dataset
get_global_ylim <- function(df) {
df %>%
select(starts_with("C")) %>%
unlist(use.names = FALSE) %>%
range(na.rm = TRUE)
}
ylim_inc <- get_global_ylim(inc)
c1_inc <- plot(inc, "C1", "Income — C1", ylim = ylim_inc)
c2_inc <- plot(inc, "C2", "Income — C2 / GINI", ylim = ylim_inc)
c3_inc <- plot(inc, "C3", "Income — C3", ylim = ylim_inc)
pdf(file = file.path(here("7_nuclear_family", "output", "plots"), "income_C123_plots.pdf"), width = 8, height = 5)
print(c1_inc)
print(c2_inc)
print(c3_inc)
dev.off()
