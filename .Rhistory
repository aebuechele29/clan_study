# ----------------
# Method 2: divide by square root of people
#   HH:    income or wealth / sqrt(numfu)
#   Clans: income or wealth / sqrt(num_clan_people)
# ----------------
r_hh_m2 <- r_hh %>%
mutate(inc_std    = inc_all / sqrt(numfu),
wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_m2 <- r_clans %>%
mutate(inc_std = inc_all / sqrt(num_clan_people))
r_hh_wealth_m2 <- r_hh_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_wealth_m2 <- r_clans_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(num_clan_people))
# ----------------
# Calculate Ginis for all standardized series
# ----------------
# Income
inc_dfs <- list(
run_gini(r_hh_m1,     "inc_std", "fam_weight",  FALSE, FALSE, "m1_hh"),
run_gini(r_clans_m1,  "inc_std", "clan_weight", FALSE, FALSE, "m1_clan"),
run_gini(r_hh_m2,     "inc_std", "fam_weight",  FALSE, FALSE, "m2_hh"),
run_gini(r_clans_m2,  "inc_std", "clan_weight", FALSE, FALSE, "m2_clan")
)
# ============================================================
# X_clan_size/src/clan_size_standardization.R
# Compare size-standardized Gini coefficients to unstandardized
# Two methods x two units x two outcomes = 4 standardized series
# plus current (unstandardized) estimates from existing CSVs
# ============================================================
library(here)
library(dplyr)
library(tidyr)
library(purrr)
library(readr)
options(survey.lonely.psu = "adjust")
out_dir <- here("X_clan_size", "output")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# ----------------
# Load data
# ----------------
r_hh         <- readRDS(here("3_households", "output", "robust_households.rds"))
r_clans      <- readRDS(here("4_clans",      "output", "robust_clans.rds"))
r_hh_wealth  <- readRDS(here("3_households", "output", "robust_households_wealth.rds"))
r_clans_wealth <- readRDS(here("4_clans",    "output", "robust_clans_wealth.rds"))
inc_current    <- read_gini(here("6_calculate_gini", "output", "income.csv"))
wealth_current <- read_gini(here("6_calculate_gini", "output", "wealth_nohouse.csv"))
# ----------------
# Method 1: divide by size
#   HH:    income or wealth / numfu
#   Clans: income or wealth / numclan
# ----------------
r_hh_m1 <- r_hh %>%
mutate(inc_std    = inc_all / numfu,
wealth_std = wealth_nohouse / numfu)
r_clans_m1 <- r_clans %>%
mutate(inc_std = inc_all / numclan)
r_hh_wealth_m1 <- r_hh_wealth %>%
mutate(wealth_std = wealth_nohouse / numfu)
r_clans_wealth_m1 <- r_clans_wealth %>%
mutate(wealth_std = wealth_nohouse / numclan)
# ----------------
# Method 2: divide by square root of people
#   HH:    income or wealth / sqrt(numfu)
#   Clans: income or wealth / sqrt(num_clan_people)
# ----------------
r_hh_m2 <- r_hh %>%
mutate(inc_std    = inc_all / sqrt(numfu),
wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_m2 <- r_clans %>%
mutate(inc_std = inc_all / sqrt(num_clan_people))
r_hh_wealth_m2 <- r_hh_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_wealth_m2 <- r_clans_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(num_clan_people))
# ----------------
# Calculate Ginis for all standardized series
# ----------------
# Income
inc_dfs <- list(
run_gini(r_hh_m1,     "inc_std", "fam_weight",  FALSE, FALSE, "m1_hh"),
run_gini(r_clans_m1,  "inc_std", "clan_weight", FALSE, FALSE, "m1_clan"),
run_gini(r_hh_m2,     "inc_std", "fam_weight",  FALSE, FALSE, "m2_hh"),
run_gini(r_clans_m2,  "inc_std", "clan_weight", FALSE, FALSE, "m2_clan")
)
inc_std <- reduce(inc_dfs, full_join, by = "year")
# Wealth
wealth_dfs <- list(
run_gini(r_hh_wealth_m1,    "wealth_std", "fam_weight",  FALSE, FALSE, "m1_hh"),
run_gini(r_clans_wealth_m1, "wealth_std", "clan_weight", FALSE, FALSE, "m1_clan"),
run_gini(r_hh_wealth_m2,    "wealth_std", "fam_weight",  FALSE, FALSE, "m2_hh"),
run_gini(r_clans_wealth_m2, "wealth_std", "clan_weight", FALSE, FALSE, "m2_clan")
)
wealth_std <- reduce(wealth_dfs, full_join, by = "year")
# ----------------
# Join with current (unstandardized) estimates
# ----------------
inc_table <- inc_current %>%
select(year, current_hh = r_hh_w_inc, current_clan = r_cl_w_inc) %>%
left_join(inc_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
wealth_table <- wealth_current %>%
select(year, current_hh = r_hh_w_wealth, current_clan = r_cl_w_wealth) %>%
left_join(wealth_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
# ----------------
# Save outputs
# ----------------
write.csv(inc_table,    file.path(out_dir, "income_size_standardized.csv"),  row.names = FALSE)
write.csv(wealth_table, file.path(out_dir, "wealth_size_standardized.csv"),  row.names = FALSE)
message("Saved: income_size_standardized.csv")
message("Saved: wealth_size_standardized.csv")
out_dir <- here("X_clan_size", "output")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# ----------------
write.csv(inc_table,    file.path(out_dir, "income_size_standardized.csv"),  row.names = FALSE)
write.csv(wealth_table, file.path(out_dir, "wealth_size_standardized.csv"),  row.names = FALSE)
message("Saved: income_size_standardized.csv")
message("Saved: wealth_size_standardized.csv")
# ============================================================
# X_clan_size/src/clan_size_standardization.R
# Compare size-standardized Gini coefficients to unstandardized
# Two methods x two units x two outcomes = 4 standardized series
# plus current (unstandardized) estimates from existing CSVs
# ============================================================
library(here)
library(dplyr)
library(tidyr)
library(purrr)
library(readr)
options(survey.lonely.psu = "adjust")
out_dir <- here("code_to_clean", "X_clan_size", "output")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# ----------------
# Load data
# ----------------
r_hh         <- readRDS(here("3_households", "output", "robust_households.rds"))
r_clans      <- readRDS(here("4_clans",      "output", "robust_clans.rds"))
r_hh_wealth  <- readRDS(here("3_households", "output", "robust_households_wealth.rds"))
r_clans_wealth <- readRDS(here("4_clans",    "output", "robust_clans_wealth.rds"))
inc_current    <- read_gini(here("6_calculate_gini", "output", "income.csv"))
wealth_current <- read_gini(here("6_calculate_gini", "output", "wealth_nohouse.csv"))
# ----------------
# Method 1: divide by size
#   HH:    income or wealth / numfu
#   Clans: income or wealth / numclan
# ----------------
r_hh_m1 <- r_hh %>%
mutate(inc_std    = inc_all / numfu,
wealth_std = wealth_nohouse / numfu)
r_clans_m1 <- r_clans %>%
mutate(inc_std = inc_all / numclan)
r_hh_wealth_m1 <- r_hh_wealth %>%
mutate(wealth_std = wealth_nohouse / numfu)
r_clans_wealth_m1 <- r_clans_wealth %>%
mutate(wealth_std = wealth_nohouse / numclan)
# ----------------
# Method 2: divide by square root of people
#   HH:    income or wealth / sqrt(numfu)
#   Clans: income or wealth / sqrt(num_clan_people)
# ----------------
r_hh_m2 <- r_hh %>%
mutate(inc_std    = inc_all / sqrt(numfu),
wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_m2 <- r_clans %>%
mutate(inc_std = inc_all / sqrt(num_clan_people))
r_hh_wealth_m2 <- r_hh_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(numfu))
r_clans_wealth_m2 <- r_clans_wealth %>%
mutate(wealth_std = wealth_nohouse / sqrt(num_clan_people))
# ----------------
# Calculate Ginis for all standardized series
# ----------------
# Income
inc_dfs <- list(
run_gini(r_hh_m1,     "inc_std", "fam_weight",  FALSE, FALSE, "m1_hh"),
run_gini(r_clans_m1,  "inc_std", "clan_weight", FALSE, FALSE, "m1_clan"),
run_gini(r_hh_m2,     "inc_std", "fam_weight",  FALSE, FALSE, "m2_hh"),
run_gini(r_clans_m2,  "inc_std", "clan_weight", FALSE, FALSE, "m2_clan")
)
inc_std <- reduce(inc_dfs, full_join, by = "year")
# Wealth
wealth_dfs <- list(
run_gini(r_hh_wealth_m1,    "wealth_std", "fam_weight",  FALSE, FALSE, "m1_hh"),
run_gini(r_clans_wealth_m1, "wealth_std", "clan_weight", FALSE, FALSE, "m1_clan"),
run_gini(r_hh_wealth_m2,    "wealth_std", "fam_weight",  FALSE, FALSE, "m2_hh"),
run_gini(r_clans_wealth_m2, "wealth_std", "clan_weight", FALSE, FALSE, "m2_clan")
)
wealth_std <- reduce(wealth_dfs, full_join, by = "year")
# ----------------
# Join with current (unstandardized) estimates
# ----------------
inc_table <- inc_current %>%
select(year, current_hh = r_hh_w_inc, current_clan = r_cl_w_inc) %>%
left_join(inc_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
wealth_table <- wealth_current %>%
select(year, current_hh = r_hh_w_wealth, current_clan = r_cl_w_wealth) %>%
left_join(wealth_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
# ----------------
# Save outputs
# ----------------
write.csv(inc_table,    file.path(out_dir, "income_size_standardized.csv"),  row.names = FALSE)
write.csv(wealth_table, file.path(out_dir, "wealth_size_standardized.csv"),  row.names = FALSE)
message("Saved: income_size_standardized.csv")
message("Saved: wealth_size_standardized.csv")
library(ggplot2)
# ----------------
# Reshape for plotting
# ----------------
inc_long <- inc_table %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit     = case_when(
grepl("hh",   series) ~ "Household",
grepl("clan", series) ~ "Clan"
),
method   = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
),
linetype = ifelse(grepl("current", series), "solid", "dashed")
)
wealth_long <- wealth_table %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit     = case_when(
grepl("hh",   series) ~ "Household",
grepl("clan", series) ~ "Clan"
),
method   = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
),
linetype = ifelse(grepl("current", series), "solid", "dashed")
)
# ----------------
# Color palette: current gets one color per unit, methods get distinct colors
# ----------------
method_colors <- c(
"Current (unstandardized)"       = "#333333",
"Method 1 (divide by size)"      = "#E66101",
"Method 2 (divide by sqrt people)" = "#4a71c7"
)
# ----------------
# Plot function
# ----------------
plot_standardized <- function(df_long, title) {
ggplot(df_long, aes(x = year, y = gini,
color    = method,
linetype = method,
group    = interaction(method, unit))) +
geom_line(linewidth = 0.9) +
facet_wrap(~ unit, ncol = 2) +
scale_color_manual(values = method_colors) +
scale_linetype_manual(values = c(
"Current (unstandardized)"         = "solid",
"Method 1 (divide by size)"        = "dashed",
"Method 2 (divide by sqrt people)" = "longdash"
)) +
labs(
title    = title,
x        = "Year",
y        = "Gini Coefficient",
color    = NULL,
linetype = NULL
) +
theme_minimal(base_size = 12) +
theme(
legend.position  = "bottom",
strip.text       = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
}
# ----------------
# Build and save plots
# ----------------
p_inc <- plot_standardized(inc_long,    "Income Gini: Size Standardization Methods")
p_wth <- plot_standardized(wealth_long, "Wealth Gini: Size Standardization Methods")
ggsave(file.path(out_dir, "income_standardized.pdf"),  p_inc, width = 10, height = 5)
ggsave(file.path(out_dir, "wealth_standardized.pdf"),  p_wth, width = 10, height = 5)
message("Saved: income_standardized.pdf")
message("Saved: wealth_standardized.pdf")
# ----------------
# Join with current (unstandardized) estimates
# ----------------
inc_table <- inc_current %>%
select(year, current_hh = r_hh_w_inc, current_clan = r_cl_w_inc) %>%
left_join(inc_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
wealth_table <- wealth_current %>%
select(year, current_hh = r_hh_w_wealth, current_clan = r_cl_w_wealth) %>%
left_join(wealth_std, by = "year") %>%
select(year,
m1_hh, m1_clan,
m2_hh, m2_clan,
current_hh, current_clan) %>%
arrange(year)
# ----------------
# Save outputs
# ----------------
write.csv(inc_table,    file.path(out_dir, "income_size_standardized.csv"),  row.names = FALSE)
write.csv(wealth_table, file.path(out_dir, "wealth_size_standardized.csv"),  row.names = FALSE)
library(ggplot2)
# ----------------
# Reshape for plotting
# ----------------
inc_long <- inc_table %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit     = case_when(
grepl("hh",   series) ~ "Household",
grepl("clan", series) ~ "Clan"
),
method   = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
),
linetype = ifelse(grepl("current", series), "solid", "dashed")
)
wealth_long <- wealth_table %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit     = case_when(
grepl("hh",   series) ~ "Household",
grepl("clan", series) ~ "Clan"
),
method   = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
),
linetype = ifelse(grepl("current", series), "solid", "dashed")
)
# ----------------
# Color palette: current gets one color per unit, methods get distinct colors
# ----------------
method_colors <- c(
"Current (unstandardized)"       = "#333333",
"Method 1 (divide by size)"      = "#E66101",
"Method 2 (divide by sqrt people)" = "#4a71c7"
)
# ----------------
# Add gap panel data
# ----------------
add_gap_panel <- function(df_long) {
df_long %>%
select(year, method, unit, gini) %>%
pivot_wider(names_from = unit, values_from = gini) %>%
mutate(
gini     = Household - Clan,
unit     = "Gap (HH - Clan)",
linetype = ifelse(method == "Current (unstandardized)", "solid", "dashed")
) %>%
select(year, series = method, gini, unit, method, linetype) %>%
bind_rows(df_long)
}
inc_long    <- add_gap_panel(inc_long)
wealth_long <- add_gap_panel(wealth_long)
# ----------------
# Plot function (3 panels)
# ----------------
plot_standardized <- function(df_long, title) {
df_long %>%
mutate(unit = factor(unit, levels = c("Household", "Clan", "Gap (HH - Clan)"))) %>%
ggplot(aes(x = year, y = gini,
color    = method,
linetype = method,
group    = interaction(method, unit))) +
geom_line(linewidth = 0.9) +
facet_wrap(~ unit, ncol = 3, scales = "free_y") +
scale_color_manual(values = method_colors) +
scale_linetype_manual(values = c(
"Current (unstandardized)"         = "solid",
"Method 1 (divide by size)"        = "dashed",
"Method 2 (divide by sqrt people)" = "longdash"
)) +
labs(
title    = title,
x        = "Year",
y        = "Gini Coefficient",
color    = NULL,
linetype = NULL
) +
theme_minimal(base_size = 12) +
theme(
legend.position  = "bottom",
strip.text       = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
}
# ----------------
# Build and save plots
# ----------------
p_inc <- plot_standardized(inc_long,    "Income Gini: Size Standardization Methods")
p_wth <- plot_standardized(wealth_long, "Wealth Gini: Size Standardization Methods")
ggsave(file.path(out_dir, "income_standardized.pdf"),  p_inc, width = 14, height = 5)
ggsave(file.path(out_dir, "wealth_standardized.pdf"),  p_wth, width = 14, height = 5)
message("Saved: income_standardized.pdf")
message("Saved: wealth_standardized.pdf")
# ----------------
# Color palette
# ----------------
method_colors <- c(
"Current (unstandardized)"         = "#333333",
"Method 1 (divide by size)"        = "#E66101",
"Method 2 (divide by sqrt people)" = "#4a71c7"
)
# ----------------
# Reshape for plotting
# ----------------
prep_long <- function(tbl) {
tbl %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit   = case_when(
grepl("hh",   series) ~ "Household",
grepl("clan", series) ~ "Clan"
),
method = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
)
)
}
inc_long    <- prep_long(inc_table)
wealth_long <- prep_long(wealth_table)
# ----------------
# Build gap rows separately from wide table (avoids pivot conflict)
# ----------------
make_gap <- function(tbl) {
tbl %>%
mutate(
m1_gap      = m1_hh      - m1_clan,
m2_gap      = m2_hh      - m2_clan,
current_gap = current_hh - current_clan
) %>%
select(year, m1_gap, m2_gap, current_gap) %>%
pivot_longer(-year, names_to = "series", values_to = "gini") %>%
mutate(
unit   = "Gap (HH - Clan)",
method = case_when(
grepl("current", series) ~ "Current (unstandardized)",
grepl("m1",      series) ~ "Method 1 (divide by size)",
grepl("m2",      series) ~ "Method 2 (divide by sqrt people)"
)
) %>%
select(year, series, gini, unit, method)
}
inc_plot    <- bind_rows(inc_long,    make_gap(inc_table))
wealth_plot <- bind_rows(wealth_long, make_gap(wealth_table))
# ----------------
# Plot function
# ----------------
plot_standardized <- function(df, title) {
df %>%
mutate(unit = factor(unit, levels = c("Household", "Clan", "Gap (HH - Clan)"))) %>%
ggplot(aes(x = year, y = gini,
color    = method,
linetype = method,
group    = interaction(method, unit))) +
geom_line(linewidth = 0.9) +
facet_wrap(~ unit, ncol = 3, scales = "free_y") +
scale_color_manual(values = method_colors) +
scale_linetype_manual(values = c(
"Current (unstandardized)"         = "solid",
"Method 1 (divide by size)"        = "dashed",
"Method 2 (divide by sqrt people)" = "longdash"
)) +
labs(title = title, x = "Year", y = "Gini Coefficient",
color = NULL, linetype = NULL) +
theme_minimal(base_size = 12) +
theme(
legend.position  = "bottom",
strip.text       = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
}
# ----------------
# Build and save
# ----------------
p_inc <- plot_standardized(inc_plot,    "Income Gini: Size Standardization Methods")
p_wth <- plot_standardized(wealth_plot, "Wealth Gini: Size Standardization Methods")
ggsave(file.path(out_dir, "income_standardized.pdf"),  p_inc, width = 14, height = 5)
ggsave(file.path(out_dir, "wealth_standardized.pdf"),  p_wth, width = 14, height = 5)
message("Saved: income_standardized.pdf")
message("Saved: wealth_standardized.pdf")
