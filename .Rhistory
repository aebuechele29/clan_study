suppressPackageStartupMessages({
library(dplyr)
library(ordinal)
library(modelsummary)
})
sim_data <- read.csv("/Users/amanda/Desktop/commensuration/2_create_outcomes/output/data.csv")
# Define control variables
control_vars <- c("gender", "race", "parent_status", "employment_status", "age", "education_years")
# Ensure factors for categorical predictors
sim_data <- sim_data %>%
mutate(
cognitive_treatment = factor(cognitive_treatment, levels = c("Invisible","Visible")),
gender_treatment    = factor(gender_treatment,    levels = c("Abstract","Gendered")),
gender    = factor(gender, levels = c("Male","Female")),
race      = factor(race,   levels = c("White","Black")),
parent_status = factor(parent_status, levels = c("Non-parent","Parent")),
employment_status = factor(employment_status, levels = c("Unemployed","Part-time","Full-time"))
)
# HYPOTHESIS 1
# Time (OLS)
h1_time_1 <- lm(total_time ~ cognitive_treatment + gender_treatment, data = sim_data)
h1_time_2 <- lm(total_time ~ cognitive_treatment + gender_treatment + gender, data = sim_data)
h1_time_3 <- lm(
as.formula(
paste("total_time ~ cognitive_treatment + gender_treatment + gender +",
paste(control_vars, collapse = " + "))
),
data = sim_data
)
modelsummary(
list("Model 1"=h1_time_1,
"Model 2"=h1_time_2,
"Model 3"=h1_time_3),
statistic = "({std.error}){stars}",
gof_omit = "IC|Log|Adj|RMSE"
)
# Effort (ordered logit)
h1_eff_1 <- clm(total_effort ~ cognitive_treatment + gender_treatment, data = sim_data)
View(sim_data)
table(sim_data$diff_assign_effort)
table(sim_data$diff_assign_f_typ)
suppressPackageStartupMessages({
library(dplyr)
library(ordinal)
library(modelsummary)
})
sim_data <- read.csv("/Users/amanda/Desktop/commensuration/2_create_outcomes/output/data.csv")
# Define control variables
control_vars <- c("gender", "race", "parent_status", "employment_status", "age", "education_years")
# Ensure factors for categorical predictors
sim_data <- sim_data %>%
mutate(
cognitive_treatment = factor(cognitive_treatment, levels = c("Invisible","Visible")),
gender_treatment    = factor(gender_treatment,    levels = c("Abstract","Gendered")),
gender    = factor(gender, levels = c("Male","Female")),
race      = factor(race,   levels = c("White","Black")),
parent_status = factor(parent_status, levels = c("Non-parent","Parent")),
employment_status = factor(employment_status, levels = c("Unemployed","Part-time","Full-time"))
)
# HYPOTHESIS 1
# Time (OLS)
h1_time_1 <- lm(total_time ~ cognitive_treatment + gender_treatment, data = sim_data)
h1_time_2 <- lm(total_time ~ cognitive_treatment + gender_treatment + gender, data = sim_data)
h1_time_3 <- lm(
as.formula(
paste("total_time ~ cognitive_treatment + gender_treatment + gender +",
paste(control_vars, collapse = " + "))
),
data = sim_data
)
modelsummary(
list("Model 1"=h1_time_1,
"Model 2"=h1_time_2,
"Model 3"=h1_time_3),
statistic = "({std.error}){stars}",
gof_omit = "IC|Log|Adj|RMSE"
)
# Effort (ordered logit)
h1_eff_1 <- lm(total_effort ~ cognitive_treatment + gender_treatment, data = sim_data)
h1_eff_2 <- lm(total_effort ~ cognitive_treatment + gender_treatment + gender, data = sim_data)
h1_eff_3 <- lm(
as.formula(
paste("total_effort ~ cognitive_treatment + gender_treatment + gender +",
paste(control_vars, collapse = " + "))
),
data = sim_data
)
modelsummary(
list("Effort ~ Treat only"=h1_eff_1,
"Effort ~ Treat + Gender"=h1_eff_2,
"Effort ~ + Controls"=h1_eff_3),
statistic = "({std.error}){stars}",
gof_omit = "IC|Log|Adj|RMSE"
)
# Name each model
all_models <- list(
"Model 1T"   = h1_time_1,
"Model 2T"   = h1_time_2,
"Model 3T"   = h1_time_3,
"Model 1E" = h1_eff_1,
"Model 2E" = h1_eff_2,
"Model 3E" = h1_eff_3
)
# Clean predictor labels
coef_labels <- c(
"cognitive_treatmentVisible" = "Visible (vs. Invisible)",
"gender_treatmentGendered"   = "Gendered (vs. Abstract)",  # <- fix here
"genderFemale"               = "Respondent Female",
"cognitive_treatmentVisible:genderFemale" = "Visible × Female",
"parent_statusParent"        = "Parent",
"employment_statusPart-time" = "Employed Part-time",
"employment_statusFull-time" = "Employed Full-time",
"raceBlack"                  = "Black",
"age"                        = "Age",
"education_years"            = "Years of Education"
)
# Output all 6 models in one table
modelsummary(
all_models,
statistic = "({std.error}){stars}",
coef_map = coef_labels,
gof_omit = "IC|Log|Adj|RMSE|AIC|BIC"
)
# Export to word doc
modelsummary(
all_models,
statistic = "({std.error}){stars}",
coef_map = coef_labels,
gof_omit = "IC|Log|Adj|RMSE|AIC|BIC",
output = "/Users/amanda/Desktop/commensuration/3_analysis/output/h1_models.docx"
)
# HYPOTHESIS 2
# Time (OLS)
h1_dtime_1 <- lm(diff_assign_time ~ cognitive_treatment + gender_treatment, data = sim_data)
h1_dtime_2 <- lm(diff_assign_time ~ cognitive_treatment + gender_treatment + gender, data = sim_data)
h1_dtime_3 <- lm(
as.formula(
paste("diff_assign_time ~ cognitive_treatment + gender_treatment + gender +",
paste(control_vars, collapse = " + "))
),
data = sim_data
)
modelsummary(
list("ΔTime: Treat only" = h1_dtime_1,
"ΔTime: + Gender"   = h1_dtime_2,
"ΔTime: + Controls" = h1_dtime_3),
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE"
)
# Effort (ordered logit)
h1_deff_1 <- lm(diff_assign_effort ~ cognitive_treatment + gender_treatment, data = sim_data, link = "logit")
h1_deff_2 <- lm(diff_assign_effort ~ cognitive_treatment + gender_treatment + gender, data = sim_data, link = "logit")
h1_deff_3 <- lm(
as.formula(
paste("diff_assign_effort ~ cognitive_treatment + gender_treatment + gender +",
paste(control_vars, collapse = " + "))
),
data = sim_data,
link = "logit"
)
modelsummary(
list("ΔEffort: Treat only" = h1_deff_1,
"ΔEffort: + Gender"   = h1_deff_2,
"ΔEffort: + Controls" = h1_deff_3),
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE"
)
# Output all 6 models in one table
modelsummary(
list("ΔTime: Treat only" = h1_dtime_1,
"ΔTime: + Gender"   = h1_dtime_2,
"ΔTime: + Controls" = h1_dtime_3,
"ΔEffort: Treat only" = h1_deff_1,
"ΔEffort: + Gender"   = h1_deff_2,
"ΔEffort: + Controls" = h1_deff_3),
statistic = "({std.error}){stars}",
coef_map  = coef_labels,
gof_omit  = "IC|Log|Adj|RMSE|AIC|BIC",
output    = "/Users/amanda/Desktop/commensuration/3_analysis/output/h2_models.docx"
)
# HYPOTHESIS 3
