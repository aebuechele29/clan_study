library(tidyverse)
# -----------------------------
# READ DATA
# -----------------------------
data <- read_csv("/Users/amanda/Desktop/franklin_foia.csv")
# -----------------------------
# RENAME + CLEAN
# -----------------------------
data <- data %>%
rename(
year = SchoolYearId,
race = RaceDescription,
gender = GenderName,
subject = SubjectDesc,
level_num = PerformanceLevel,
percent = Percentage
) %>%
mutate(
level = factor(
level_num,
levels = c(1, 2, 3, 4),
labels = c("Level 1", "Level 2", "Level 3", "Level 4")
),
subject = factor(subject, levels = c("ELA", "Mathematics")),
gender = factor(gender, levels = c("Female", "Male")),
race = factor(race)
)
# -----------------------------
# BAR GRAPH 1: by gender
# -----------------------------
plot_gender <- ggplot(data, aes(x = level, y = percent, fill = gender)) +
geom_col(position = "dodge") +
facet_wrap(~subject) +
labs(
title = "Performance Level Distribution by Gender",
x = "Performance Level",
y = "Percent of Students at Level",
fill = "Gender"
) +
theme_minimal()
# -----------------------------
# BAR GRAPH 2: by race
# -----------------------------
plot_race <- ggplot(data, aes(x = level, y = percent, fill = race)) +
geom_col(position = "dodge") +
facet_wrap(~subject) +
labs(
title = "Performance Level Distribution by Race",
x = "Performance Level",
y = "Percent of Students at Level",
fill = "Race"
) +
theme_minimal()
# -----------------------------
# CREATE PROFICIENCY DATA
# Level 3 + Level 4
# -----------------------------
proficiency_rg <- data %>%
filter(level %in% c("Level 3", "Level 4")) %>%
group_by(year, subject, race, gender) %>%
summarise(proficiency = sum(percent), .groups = "drop") %>%
filter(
race %in% c("Black or African American", "White"),
gender %in% c("Female", "Male")
) %>%
mutate(
group = case_when(
race == "Black or African American" & gender == "Female" ~ "Black girls",
race == "White" & gender == "Female" ~ "White girls",
race == "Black or African American" & gender == "Male" ~ "Black boys",
race == "White" & gender == "Male" ~ "White boys"
),
group = factor(
group,
levels = c("Black girls", "White girls", "Black boys", "White boys")
)
)
# -----------------------------
# LINE GRAPH 1: Math only
# -----------------------------
plot_math <- proficiency_rg %>%
filter(subject == "Mathematics") %>%
ggplot(aes(x = year, y = proficiency, color = group, group = group)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
scale_x_continuous(breaks = sort(unique(data$year))) +
labs(
title = "Math Proficiency Over Time by Race and Gender",
x = "Year",
y = "Percent Proficient (Level 3 or 4)",
color = "Group"
) +
theme_minimal()
# -----------------------------
# LINE GRAPH 2: ELA only
# -----------------------------
plot_ela <- proficiency_rg %>%
filter(subject == "ELA") %>%
ggplot(aes(x = year, y = proficiency, color = group, group = group)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
scale_x_continuous(breaks = sort(unique(data$year))) +
labs(
title = "ELA Proficiency Over Time by Race and Gender",
x = "Year",
y = "Percent Proficient (Level 3 or 4)",
color = "Group"
) +
theme_minimal()
# -----------------------------
# DISPLAY PLOTS IN R
# -----------------------------
print(plot_gender)
print(plot_race)
print(plot_math)
print(plot_ela)
# -----------------------------
# SAVE ALL PLOTS TO ONE PDF
# -----------------------------
pdf("/Users/amanda/Desktop/franklin_score_plots.pdf", width = 10, height = 7)
print(plot_gender)
print(plot_race)
print(plot_math)
print(plot_ela)
dev.off()
