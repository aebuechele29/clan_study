	file = {Full Text PDF:/Users/amanda/Zotero/storage/9E7JYCNG/McKernan et al. - 2014 - Do Racial Disparities in Private Transfers Help Explain the Racial Wealth Gap New Evidence From Lon.pdf:application/pdf;Snapshot:/Users/amanda/Zotero/storage/2LCRVPSR/s13524-014-0296-7.html:text/html},
}

