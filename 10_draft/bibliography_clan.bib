	pages = {305--322},
	file = {Full text PDF:/Users/amanda/Zotero/storage/YZZUXAX2/Aaberge - 2007 - Gini’s nuclear family..pdf:application/pdf},
}

@article{obrien_structural_2020,
	title = {Structural racism, economic opportunity and racial health disparities: {Evidence} from {U}.{S}. counties},
	volume = {11},
	issn = {2352-8273},
	shorttitle = {Structural racism, economic opportunity and racial health disparities},
	url = {https://www.sciencedirect.com/science/article/pii/S2352827319303623},
	doi = {10.1016/j.ssmph.2020.100564},
	abstract = {In this study, we introduce the ‘racial opportunity gap’ as a place-based measure of structural racism for use in population health research. We first detail constructing the opportunity gap using race-sex specific estimates of intergenerational economic mobility outcomes for a recent cohort. We then illustrate its utility in examining spatial variation in the racial mortality gap. First we demonstrate a correlation between the racial opportunity gap and the racial mortality gap across U.S. counties; where the gap in the adult earnings of black and white children born to families at the same income level is greater so, too, is the gap in mortality. Second, we show in a multivariable framework that the racial opportunity gap is associated with the racial mortality gap net of differences in the socioeconomic composition of the two groups. In so doing, we aim to provide population health researchers with a new empirical tool and analytic framework for examining the role of structural racism in generating racial health disparities.},
	urldate = {2025-12-18},
	journal = {SSM - Population Health},
	author = {O'Brien, Rourke and Neman, Tiffany and Seltzer, Nathan and Evans, Linnea and Venkataramani, Atheendar},
	month = aug,
	year = {2020},
	keywords = {Inequality, Race, Racism, Mortality, Population health, Racial health disparities},
	pages = {100564},
	file = {ScienceDirect Snapshot:/Users/amanda/Zotero/storage/IEJ72Y4T/S2352827319303623.html:text/html},
}

